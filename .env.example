# ==============================================================================
# SHAN-DEEP TENDER INTELLIGENCE PLATFORM (procure-brain.com)
# Environment Configuration Template (.env.example)
# ==============================================================================

PORT=4000
NODE_ENV=development

# 1. Tenderbook (Metalbook) Live Tender APIs
TENDERBOOK_API_URL=https://dev-api.tenderbook.in
TENDERBOOK_API_KEY=api-key your_tenderbook_key_here
TENDERBOOK_KEY_VALID_TILL=2026-10-25

# 2. Database Connection (PostgreSQL with RLS)
DATABASE_URL=postgres://app_api_user:shandeep_api_secret_2026@localhost:5432/shandeep_db

# 3. Microsoft 365 / Azure Entra ID (Graph sendMail)
AZURE_TENANT_ID=your_azure_tenant_id
AZURE_CLIENT_ID=your_azure_client_id
AZURE_CLIENT_SECRET=your_azure_client_secret
GRAPH_SENDER_MAILBOX=alerts@procure-brain.com

# 4. Meta WhatsApp Business Cloud API
META_WHATSAPP_TOKEN=your_meta_token
META_PHONE_NUMBER_ID=your_phone_id

# 5. Contractor KYB Verification
KYB_PROVIDER_API_KEY=your_kyb_api_key
