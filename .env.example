# Local development settings. Copy to .env (never commit it). For a server, use deploy/production.env.example.
# Every integration is OFF until you switch it on, so a fresh checkout cannot send mail or call a paid API.

PORT=4000
NODE_ENV=development
# The public origin the portal is served from. Emailed password-reset and invite
# links are built from this, so on a server it MUST be the real URL (e.g.
# https://www.procure-brain.in), not localhost. With MAIL_MODE=live the app
# refuses to start if this is still a localhost address.
PUBLIC_BASE_URL=http://localhost:5173
# Optional browser access to the synthetic sample tenders in Supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Database. Leave DATABASE_URL empty to use the embedded database (stored in backend/var/pgdata);
# set it to use a real PostgreSQL server. DB_DRIVER=pglite forces the embedded one.
DB_DRIVER=auto
DATABASE_URL=
# Direct owner connection for SQL migrations; DIRECT_URL is an alias.
MIGRATION_DATABASE_URL=
DIRECT_URL=
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=30000
DB_TRANSACTION_TIMEOUT_MS=120000
# Optional trusted database CA PEM (e.g. the AWS RDS regional bundle).
DB_SSL_CA_FILE=
# off when migrations run as a separate deployment step.
DB_MIGRATE_ON_START=on
PGLITE_DIR=var/pgdata

# Create sample accounts and data on start-up (development only; ignored in production).
# Sign in with admin@demo.test, manager@demo.test, analyst@demo.test, owner@demo.test or
# subscriber@demo.test, password Demo-Pass-2026.
SEED_DEMO=on

# Background jobs (digests, mail queue, reminders, weekly reports). off = run the API alone.
JOBS_ENABLED=on

# Tender data. Get a NEW key from Metalbook; never put one in the code or in a browser.
TENDERBOOK_SYNC=off
TENDERBOOK_API_URL=https://dev-api.tenderbook.in
TENDERBOOK_API_KEY=
TENDERBOOK_KEY_VALID_TILL=

# Web crawler for the Central Public Procurement Portal (eprocure.gov.in).
# off = do not crawl. Crawl politely: keep the delay and a low detail cap.
CRAWLER_ENABLED=off
CRAWLER_CPPP_URL=https://eprocure.gov.in
CRAWLER_CPPP_LIST_PATH=/epublish/app?page=FrontEndLatestActiveTenders&service=page
CRAWL_INTERVAL_MINUTES=120
CRAWLER_MAX_PAGES=100
CRAWLER_REQUEST_DELAY_MS=1500
CRAWLER_MAX_DETAILS=60
CRAWLER_TIMEOUT_MS=30000

# Tender PDF enrichment. Reads estimated value / EMD / tender fee out of tender
# notice (NIT) PDFs to fill the money fields the listings omit, then discards the
# file. Deterministic (no LLM). Only tenders that carry a downloadable document
# are processed. off = do not enrich. Idempotent: never re-reads an unchanged PDF.
ENRICH_ENABLED=off
ENRICH_PROVIDER_ID=                          # limit to one provider id (e.g. gujarat) while piloting; blank = all
ENRICH_MAX_DOCS=60                           # PDFs processed per run (raise to clear a backlog faster)
ENRICH_REQUEST_DELAY_MS=1200                 # polite pause between PDF downloads
ENRICH_INTERVAL_MINUTES=180                  # how often the enrichment job runs
ENRICH_TIMEOUT_MS=20000
ENRICH_MAX_BYTES=15728640                    # skip documents larger than this (15 MB)
ENRICH_MAX_PAGES=15                          # text-layer pages read per PDF (money fields are up front)

# Email. dry_run writes each message as an HTML file under backend/var/outbox instead of sending it.
MAIL_MODE=dry_run
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
GRAPH_SENDER_MAILBOX=
OPS_ALERT_EMAIL=

# Website contact details
CONTACT_PHONE=+91 79743 92235
CONTACT_EMAIL=shantanu.trivedi@procure-brain.com
WHATSAPP_NUMBER=918269868808
