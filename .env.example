# Local development settings. Copy to .env (never commit it). For a server, use deploy/production.env.example.
# Every integration is OFF until you switch it on, so a fresh checkout cannot send mail or call a paid API.

PORT=4000
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:5173

# Database. Leave DATABASE_URL empty to use the embedded database (stored in backend/var/pgdata);
# set it to use a real PostgreSQL server. DB_DRIVER=pglite forces the embedded one.
DB_DRIVER=auto
DATABASE_URL=
# Direct owner connection for SQL migrations; DIRECT_URL is an alias.
MIGRATION_DATABASE_URL=
DIRECT_URL=
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=30000
DB_TRANSACTION_TIMEOUT_MS=120000
# Optional trusted database CA PEM (e.g. the AWS RDS regional bundle).
DB_SSL_CA_FILE=
# off when migrations run as a separate deployment step.
DB_MIGRATE_ON_START=on
PGLITE_DIR=var/pgdata

# Create sample accounts and data on start-up (development only; ignored in production).
# Sign in with admin@demo.test, manager@demo.test, analyst@demo.test, owner@demo.test or
# subscriber@demo.test, password Demo-Pass-2026.
SEED_DEMO=on

# Background jobs (digests, mail queue, reminders, weekly reports). off = run the API alone.
JOBS_ENABLED=on

# Tender data. Get a NEW key from Metalbook; never put one in the code or in a browser.
TENDERBOOK_SYNC=off
TENDERBOOK_API_URL=https://dev-api.tenderbook.in
TENDERBOOK_API_KEY=
TENDERBOOK_KEY_VALID_TILL=

# Email. dry_run writes each message as an HTML file under backend/var/outbox instead of sending it.
MAIL_MODE=dry_run
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
GRAPH_SENDER_MAILBOX=
OPS_ALERT_EMAIL=

# Website contact details
CONTACT_PHONE=+91 82698 68808
CONTACT_EMAIL=info@synquic.com
WHATSAPP_NUMBER=918269868808
