{
  "name": "shandeep-backend-api",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "seed:demo": "node src/db/seed.js --demo",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "postinstall": "prisma generate",
    "db:schema": "node scripts/prisma-sync.mjs",
    "db:schema:check": "node scripts/prisma-sync.mjs --check",
    "test": "node --import ./test/setup.js --test --test-concurrency=1 \"test/**/*.test.js\""
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "croner": "^10.0.1",
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "pglite-prisma-adapter": "^0.7.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "prisma": "^7.10.1",
    "supertest": "^7.3.1"
  }
}
