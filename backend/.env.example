# Shan-Deep Tender Intelligence Platform (procure-brain.com)
# Production Environment Configuration Blueprint

# 1. Server & Security Configuration
PORT=4000
NODE_ENV=production
SESSION_SECRET=shandeep_session_master_key_2026_super_secure_random
CORS_ALLOWED_ORIGINS=https://procure-brain.com,https://app.procure-brain.com

# 2. Database Connection Pooling (PostgreSQL 15+)
# Format: postgres://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URL=postgres://app_api_user:shandeep_api_secret_2026@postgres.internal:5432/shandeep_db?sslmode=prefer
DATABASE_MAX_CONNECTIONS=25
DATABASE_IDLE_TIMEOUT_MS=30000

# 3. Live Tender Ingestion Feed (Category 1)
# Primary: Tenderbook B2B API / Apify CPPP+GeM Crawler Feed
TENDER_FEED_PROVIDER=Tenderbook_API
TENDER_FEED_BASE_URL=https://api.tenderbook.in/v1
TENDER_FEED_API_KEY=live_tb_prod_key_xxxxxxxxxxxxxxxx
TENDER_FEED_SYNC_INTERVAL_MINUTES=30

# 4. Microsoft 365 / Graph API Email Dispatcher (Category 3)
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=your_azure_entra_app_client_secret
AZURE_SENDER_MAILBOX=alerts@procure-brain.com
EMAIL_RATE_LIMIT_PER_MINUTE=25

# 5. Meta WhatsApp Business Cloud API (Category 3)
WHATSAPP_API_VERSION=v20.0
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_meta_business_account_id
WHATSAPP_SYSTEM_USER_ACCESS_TOKEN=EAABxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_WEBHOOK_VERIFY_TOKEN=shandeep_wa_verify_token_2026

# 6. Contractor KYB & Eligibility Verification (Category 2)
# Surepass / Karza / Perfios API Integration
SUREPASS_API_BASE_URL=https://kyc.surepass.io/api/v1
SUREPASS_BEARER_TOKEN=your_surepass_production_token
GST_VERIFICATION_ENABLED=true
UDYAM_MSME_VERIFICATION_ENABLED=true

# 7. Private Cloud Object Storage (Category 5 - FR-CASE-011 Vault)
STORAGE_PROVIDER=aws_s3
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_VAULT_BUCKET=shandeep-case-vault-prod
PRESIGNED_URL_EXPIRY_SECONDS=900
