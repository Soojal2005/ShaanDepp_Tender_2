generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model alert_digest_items {
  id              BigInt        @id @default(autoincrement())
  digest_id       Int
  tender_id       BigInt
  score           Int
  rank_position   Int
  in_digest       Boolean
  is_closing_soon Boolean       @default(false)
  alert_digests   alert_digests @relation(fields: [digest_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tenders         tenders       @relation(fields: [tender_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([digest_id], map: "idx_digest_items_digest")
  @@index([tender_id], map: "idx_digest_items_tender")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model alert_digests {
  id                 Int                  @id @default(autoincrement())
  organization_id    Int
  profile_id         Int
  digest_date        DateTime             @db.Date
  is_test            Boolean              @default(false)
  matched_count      Int                  @default(0)
  included_count     Int                  @default(0)
  cap                Int
  generated_at       DateTime             @default(now()) @db.Timestamptz(6)
  alert_digest_items alert_digest_items[]
  organizations      organizations        @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  alert_profiles     alert_profiles       @relation(fields: [profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  email_queue        email_queue[]

  @@unique([profile_id, digest_date], map: "uq_digest_profile_day", where: raw("(NOT is_test)"))
  @@index([profile_id, digest_date(sort: Desc)], map: "idx_digests_profile_date")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model alert_profiles {
  id                    Int             @id @default(autoincrement())
  organization_id       Int
  user_id               Int?
  name                  String
  keywords              String[]        @default([])
  exclude_keywords      String[]        @default([])
  tender_types          String[]        @default([])
  value_min             Decimal?        @db.Decimal(18, 2)
  value_max             Decimal?        @db.Decimal(18, 2)
  recipient_emails      String[]        @default([])
  frequency             String          @default("daily")
  weekly_day            Int             @default(1)
  status                String          @default("active")
  last_run_at           DateTime?       @db.Timestamptz(6)
  created_at            DateTime        @default(now()) @db.Timestamptz(6)
  updated_at            DateTime        @default(now()) @db.Timestamptz(6)
  category_ids          Int[]           @default([])
  department_ids        Int[]           @default([])
  state_ids             Int[]           @default([])
  include_unknown_value Boolean         @default(true)
  alert_digests         alert_digests[]
  organizations         organizations   @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                 users?          @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([organization_id], map: "idx_alert_profiles_org")
}

