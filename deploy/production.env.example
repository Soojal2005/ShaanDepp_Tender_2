# Copy to .env on the server (never commit .env) and fill in every value marked CHANGE.
# Anything left blank keeps its integration switched off; the system never sends mail
# or calls a paid service until the matching switch is turned on.

# ---- Where the site lives ---------------------------------------------------------------
SITE_DOMAIN=procure-brain.com              # CHANGE if different; the DNS A record must point at this server

# ---- Database (PostgreSQL runs in the same compose file) -------------------------------------
POSTGRES_PASSWORD=CHANGE-to-a-long-random-string
APP_DB_PASSWORD=CHANGE-to-a-different-long-random-string

# ---- First administrator (created once, on first start) ---------------------------------------
BOOTSTRAP_ADMIN_EMAIL=CHANGE@example.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE-at-least-10-characters-with-a-digit
BOOTSTRAP_ADMIN_NAME=Platform Administrator

# ---- Tender data (Tenderbook / Metalbook), licensed in the client's name --------------------------
TENDERBOOK_SYNC=off                        # on, once the key below is set
TENDERBOOK_API_URL=https://dev-api.tenderbook.in
TENDERBOOK_API_KEY=
TENDERBOOK_KEY_VALID_TILL=                 # YYYY-MM-DD; an ops reminder email goes out 7 days before
INGEST_INTERVAL_MINUTES=120

# ---- Email through the client's Microsoft 365 mailbox ------------------------------------------------
MAIL_MODE=dry_run                          # live, once the four values below are set (see docs/AZURE_M365_SETUP.md)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
GRAPH_SENDER_MAILBOX=alerts@procure-brain.com
GRAPH_RATE_LIMIT_PER_MIN=25
GRAPH_DAILY_LIMIT=10000
GRAPH_BOUNCE_POLL=off                      # on if the app also has Mail.Read on the mailbox
OPS_ALERT_EMAIL=                           # who hears about ingestion failures and key expiry

# ---- Website contact details (shown on the public site) -----------------------------------------------
CONTACT_PHONE=                             # CHANGE: Shan-Deep's own number
CONTACT_EMAIL=                             # CHANGE: Shan-Deep's own address
WHATSAPP_NUMBER=                           # digits only with country code, e.g. 919876543210

# ---- Backups -------------------------------------------------------------------------------------------
BACKUP_KEEP_DAYS=14
