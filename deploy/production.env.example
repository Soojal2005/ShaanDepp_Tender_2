# Copy to .env on the server (never commit .env) and fill in every value marked CHANGE.
# Anything left blank keeps its integration switched off; the system never sends mail
# or calls a paid service until the matching switch is turned on.

# ---- Where the site lives ---------------------------------------------------------------
SITE_DOMAIN=procure-brain.com              # CHANGE if different; the DNS A record must point at this server

# ---- Database (PostgreSQL runs in the same compose file) -------------------------------------
POSTGRES_PASSWORD=CHANGE-to-a-long-random-string
APP_DB_PASSWORD=CHANGE-to-a-different-long-random-string

# ---- First administrator (created once, on first start) ---------------------------------------
BOOTSTRAP_ADMIN_EMAIL=CHANGE@example.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE-at-least-10-characters-with-a-digit
BOOTSTRAP_ADMIN_NAME=Platform Administrator

# ---- Tender data (Tenderbook / Metalbook), licensed in the client's name --------------------------
TENDERBOOK_SYNC=off                        # on, once the key below is set
TENDERBOOK_API_URL=https://dev-api.tenderbook.in
TENDERBOOK_API_KEY=
TENDERBOOK_KEY_VALID_TILL=                 # YYYY-MM-DD; an ops reminder email goes out 7 days before
INGEST_INTERVAL_MINUTES=120

# ---- Government-portal crawler (CPPP + state portals, NIC GePNIC) ------------------------------------
# Scrapes the captcha-free "Tenders by Closing Date" listing with a headless browser.
# Chromium is already in the image, so just switch this on.
CRAWLER_ENABLED=on
CRAWLER_ENGINE=browser
CRAWL_INTERVAL_MINUTES=120                  # how often to crawl all portals (every 2 hours)
CRAWLER_MAX_PAGES=100                       # listing pages per portal (~10 tenders each); stops early when exhausted
CRAWLER_REQUEST_DELAY_MS=1500               # polite pause between requests/portals
CRAWLER_TIMEOUT_MS=45000

# ---- Tender PDF enrichment (fills estimated value / EMD / tender fee from NIT PDFs) -----------------
# Deterministic, no LLM. Only tenders with a downloadable document are processed (mainly nProcure;
# GePNIC docs are captcha-gated and skipped). Idempotent — never re-reads an unchanged PDF.
ENRICH_ENABLED=on
ENRICH_PROVIDER_ID=                          # blank = all providers; set e.g. gujarat to pilot one portal
ENRICH_MAX_DOCS=150                          # PDFs per run; 150/hour clears the initial backlog in ~1-2 days
ENRICH_REQUEST_DELAY_MS=1000                 # polite pause between PDF downloads
ENRICH_INTERVAL_MINUTES=60                   # once caught up, relax to 180 and MAX_DOCS=60 for steady state
ENRICH_TIMEOUT_MS=20000
ENRICH_MAX_PAGES=15

# ---- Email --------------------------------------------------------------------------------------------
MAIL_MODE=dry_run                          # CHANGE to `live` to actually send (OTPs, resets, alert digests)
MAIL_TRANSPORT=smtp                        # smtp (Hostinger, below) or graph (Microsoft 365, further down)

# SMTP (Hostinger). Used when MAIL_TRANSPORT=smtp and MAIL_MODE=live.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true                           # true for 465 (SSL/TLS); false for 587 (STARTTLS)
SMTP_USER=CHANGE@your-domain               # CHANGE: the full mailbox address (the SMTP login)
SMTP_PASS=                                 # CHANGE: that mailbox's password
MAIL_FROM=Procure Brain <CHANGE@your-domain>   # CHANGE: display name + the SMTP_USER address

# Microsoft 365 / Graph — only if MAIL_TRANSPORT=graph (see docs/AZURE_M365_SETUP.md).
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
GRAPH_SENDER_MAILBOX=alerts@procure-brain.com
GRAPH_RATE_LIMIT_PER_MIN=25
GRAPH_DAILY_LIMIT=10000
GRAPH_BOUNCE_POLL=off                      # on if the app also has Mail.Read on the mailbox
OPS_ALERT_EMAIL=                           # who hears about ingestion failures and key expiry

# ---- Website contact details (shown on the public site) -----------------------------------------------
CONTACT_PHONE=                             # CHANGE: Shan-Deep's own number
CONTACT_EMAIL=                             # CHANGE: Shan-Deep's own address
WHATSAPP_NUMBER=                           # digits only with country code, e.g. 919876543210

# ---- Backups -------------------------------------------------------------------------------------------
BACKUP_KEEP_DAYS=14
