# Automatic HTTPS (Let's Encrypt). www.{$SITE_DOMAIN} is the canonical host (it is
# what the email links use); the bare apex redirects to it. BOTH DNS records — the
# apex and the www CNAME/A — must point at this server.
www.{$SITE_DOMAIN} {
	encode zstd gzip

	# Uploads are capped at 15 MB by the application; leave headroom for the form fields.
	request_body {
		max_size 20MB
	}

	reverse_proxy api:4000 {
		health_uri /api/v1/health
		health_interval 30s
	}
}

{$SITE_DOMAIN} {
	redir https://www.{$SITE_DOMAIN}{uri} permanent
}
