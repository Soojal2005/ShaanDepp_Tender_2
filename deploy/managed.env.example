# AWS EC2/ECS/App Runner with RDS/Aurora PostgreSQL or Supabase PostgreSQL.
# Copy to .env for docker-compose.managed.yml. Never commit real credentials.
SITE_DOMAIN=CHANGE.example.com
NODE_ENV=production
DB_DRIVER=pg
PUBLIC_BASE_URL=https://CHANGE.example.com

# Runtime: restricted app_api_user, never the database owner.
# Percent-encode special characters in the password in both URLs.
DATABASE_URL=postgresql://app_api_user:CHANGE_PASSWORD@CHANGE_HOST:5432/CHANGE_DATABASE?sslmode=require
# Deployment job only: direct/session endpoint with CREATE ROLE and schema ownership.
MIGRATION_DATABASE_URL=postgresql://postgres:CHANGE_OWNER_PASSWORD@CHANGE_HOST:5432/CHANGE_DATABASE?sslmode=require
# Sets the app_api_user login password during migration (raw password, not URL encoded).
APP_DB_PASSWORD=CHANGE_PASSWORD
DB_MIGRATE_ON_START=off
DB_POOL_MAX=5
DB_CONNECT_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=30000
DB_TRANSACTION_TIMEOUT_MS=120000
# With a custom CA, mount it in both release and API containers and set its absolute path.
DB_SSL_CA_FILE=

BOOTSTRAP_ADMIN_EMAIL=CHANGE@example.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE-at-least-10-characters-with-a-digit
BOOTSTRAP_ADMIN_NAME=Platform Administrator
JOBS_ENABLED=on
MAIL_MODE=dry_run
TENDERBOOK_SYNC=off
STORAGE_DIR=/data/storage
OUTBOX_DIR=/data/outbox
