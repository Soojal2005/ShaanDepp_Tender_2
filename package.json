{
  "name": "shandeep-tender-intelligence",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev --prefix backend\" \"vite\"",
    "dev:web": "vite",
    "dev:api": "npm run dev --prefix backend",
    "build": "node scripts/generate-seo.mjs && vite build",
    "preview": "vite preview",
    "test": "npm test --prefix backend",
    "migrate": "npm run migrate --prefix backend",
    "db:generate": "npm run db:generate --prefix backend",
    "db:validate": "npm run db:validate --prefix backend",
    "seed": "npm run seed --prefix backend",
    "seed:showcase": "npm run seed:showcase --prefix backend",
    "postinstall": "npm install --prefix backend"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^9.0.0",
    "vite": "^5.1.6"
  }
}
